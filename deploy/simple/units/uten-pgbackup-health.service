[Unit]
Description=Uten IMP local repo1/repo2 read-only backup and WAL health
After=postgresql@16-main.service uten-pgbackup.service
OnFailure=uten-alert@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0027
StateDirectory=uten-imp-backup-health
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/uten-imp-backup/local_backup_health.py
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateNetwork=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uten-imp-backup-health
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=128M
CPUQuota=20%
TasksMax=16
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=5min
