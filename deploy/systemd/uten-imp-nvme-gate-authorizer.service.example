# Reference only. existing-test-host-nvme-commissioner.py renders the real
# static unit with @VERSIONED_HELPER@ replaced by its SHA-256-versioned copy.
[Unit]
Description=Authorize Uten IMP unit starts around NVMe transactions
DefaultDependencies=no
After=systemd-remount-fs.service
Before=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=uten-imp-nvme-gate-authorizer
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 -I @VERSIONED_HELPER@ authorize-gate
ExecReload=/usr/bin/python3 -I @VERSIONED_HELPER@ authorize-gate
TimeoutStartSec=60s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=yes

# No [Install] section. Protected units pull this service in with Requires+After.
# Without active.json it writes all fixed unit markers. With active.json it
# writes none unless a live late-resume grant exactly binds the pointer, boot,
# invocation, PID/start identity, two held maintenance locks and permitted unit.
