# Dedicated table, applied atomically by apply_firewall.py. Never flush ruleset.
table inet uten_remote {
    chain input {
        type filter hook input priority -10; policy accept;
        iifname "wg-uten" ip saddr @@COMPANY_WIREGUARD_IPV4@@ ip daddr @@CLOUD_WIREGUARD_IPV4@@ tcp sport 8443 ct state established accept
        iifname "wg-uten" drop
    }
    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname "wg-uten" drop
        oifname "wg-uten" drop
    }
    chain output {
        type filter hook output priority -10; policy accept;
        meta skuid "uten-remote" ct state established,related accept
        meta skuid "uten-remote" ip daddr @@COMPANY_WIREGUARD_IPV4@@ tcp dport 8443 accept
        meta skuid "uten-remote" drop
    }
}
