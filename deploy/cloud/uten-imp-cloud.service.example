# 云端（阿里云 ECS）systemd 单元示例。复制为 /etc/systemd/system/uten-imp-cloud.service，
# 放好 /etc/uten-imp/server-cloud.env（见 README-cloud.md）后再启用。
[Unit]
Description=Uten IMP cloud instance (remote-access gateway + read replica)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=uten-imp
Group=uten-imp
WorkingDirectory=/opt/uten-imp/current
EnvironmentFile=/etc/uten-imp/server-cloud.env
ExecStartPre=/usr/bin/test -L /opt/uten-imp/current
ExecStartPre=/usr/bin/test -r /opt/uten-imp/current/server/uten-imp-server.jar
ExecStart=/usr/bin/java -XX:+ExitOnOutOfMemoryError -jar /opt/uten-imp/current/server/uten-imp-server.jar
Restart=always
RestartSec=3
SuccessExitStatus=143
TimeoutStartSec=60
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
