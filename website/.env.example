# 本地默认 SQLite；PostgreSQL 使用生成的独立 schema/client，运行时根据 URL 选择。
# 已有数据不能只换 URL：先生成客户端、迁移空目标，再从一致离线备份迁移并回读。
# PostgreSQL 示例只说明格式，不含可用凭据：postgresql://USER:PASSWORD@127.0.0.1:5432/WEBSITE
DATABASE_URL="file:./dev.db"

# JWT 签名密钥。必须是至少 43 字符的密码学随机串；示例/短值会让服务安全停止。
# 可用: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# 初始管理员账号。密码故意留空：seed 会 fail closed，必须先填写唯一强密码。
# 要求至少 14 位，并包含大小写字母、数字、符号中的至少三类；禁止默认/示例密码。
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# seed 会 deleteMany 清空内容。只有确认目标数据库可丢弃时才临时改为 true，执行后立即改回 false。
ALLOW_DESTRUCTIVE_SEED="false"

# 仅当可信反向代理会覆盖该请求头且应用源站不可直连时填写，例如 cf-connecting-ip。
# 留空时后台不信任任何客户端 IP 请求头，账号与全局登录限速仍然生效。
ADMIN_TRUSTED_CLIENT_IP_HEADER=""

# 公开询盘限流。只有可信代理覆盖请求头且源站不可直连时才填写 IP header。
# 本地保持空值；采用部署手册的 Nginx 配置时，生产环境必须设为 x-real-ip。
INQUIRY_TRUSTED_CLIENT_IP_HEADER=""
INQUIRY_RATE_CLIENT_MINUTE="3"
INQUIRY_RATE_CLIENT_HOUR="15"
INQUIRY_RATE_GLOBAL_MINUTE="30"
INQUIRY_RATE_GLOBAL_HOUR="300"

# 站点对外域名 (生成 sitemap / 绝对链接用)
SITE_URL="http://localhost:3000"

# 本地开发留空时继续使用 public/uploads。生产必须显式设为
# /var/lib/uten-website/runtime/uploads，并由 root 按部署手册创建权限。
UPLOADS_DIR=""

# PDF 私有存储；本地留空使用 .local-state/documents，不放在 public/uploads。
# 生产必须显式设为 /var/lib/uten-website/runtime/documents，并单独准备耐久目录。
DOCUMENTS_DIR=""

# IMP 主动出站拉取已持久化的询盘，ERP 入库提交后精确 ACK。
# 断连时网站继续保存 PENDING，后台仅展示送达状态；认领与跟进统一在 IMP 办理。
# siteId 与 IMP 连接配置一致。后端桥接令牌留空则桥接安全关闭，不影响公开站点或询盘保存。
# 令牌必须为 43–512 位密码学随机串（可用 openssl rand -base64 48），只放两端服务端。
# 不再使用旧 IMP_INGEST_URL / IMP_INGEST_TOKEN 即时推送配置。
WEB_SITE_ID="uten"
UTEN_WEBSITE_BRIDGE_TOKEN=""
