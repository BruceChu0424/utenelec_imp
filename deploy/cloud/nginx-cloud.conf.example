# Include this file from Nginx's `http` context only after replacing every
# all-caps placeholder token. The cloud Spring Boot service must listen on 127.0.0.1:8080
# (or be firewalled so only this Nginx host can reach it); never expose 8080 to
# the Internet.

# Coarse IP flood guards. Application account/phone limits remain authoritative.
# Load-test these values behind the real Alibaba Cloud WAF/SLB/NAT path before GO.
limit_req_zone $binary_remote_addr zone=uten_cloud_health_ip:10m rate=1000r/s;
limit_req_zone $binary_remote_addr zone=uten_cloud_auth_ip:10m rate=300r/s;
limit_req_zone $binary_remote_addr zone=uten_cloud_api_ip:20m rate=3000r/m;
limit_req_zone $binary_remote_addr zone=uten_cloud_goods_import_ip:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=uten_cloud_goods_import_conn:10m;
limit_req_zone $binary_remote_addr zone=uten_cloud_ai_jobs_ip:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=uten_cloud_ai_jobs_conn:10m;

map $uri $uten_maintenance_cache_control {
    default "";
    /api/system/maintenance "no-store";
    /maintenance.html "no-store";
    /maintenance.css "no-store";
    /maintenance.js "no-store";
}

upstream uten_imp_cloud_backend {
    # Loopback is a required trust boundary. Keep the application bound to
    # 127.0.0.1:8080 and deny direct security-group/firewall access to 8080.
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name __CLOUD_DOMAIN__;
    server_tokens off;
    if ($host != "__CLOUD_DOMAIN__") { return 444; }
    return 308 https://__CLOUD_DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __CLOUD_DOMAIN__;
    server_tokens off;
    limit_req_status 429;
    if ($host != "__CLOUD_DOMAIN__") { return 444; }

    ssl_certificate __TLS_CERT_PATH__;
    ssl_certificate_key __TLS_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;

    # `current` must be an atomically replaced symlink to an immutable release.
    # Never copy a new Flutter build through this path in place.
    root /opt/uten-imp/current/web;
    index index.html;

    # Cloud production uses OSS presigned uploads; ordinary API JSON stays at
    # the gateway's 2 MiB boundary. Do not raise this to the attachment maximum.
    client_max_body_size 2m;

    # Keep Nginx and Tomcat request-header budgets aligned. Each field/request
    # line must still fit in 8 KiB; the exceptional aggregate is about 16 KiB.
    client_header_buffer_size 4k;
    large_client_header_buffers 2 8k;

    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 45s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/wasm
        image/svg+xml
        text/css
        text/plain;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # REQUIRED: replace __OSS_PUBLIC_HOST__ with the exact public virtual-host
    # name used by presigned URLs, for example
    # bucket-name.oss-cn-hangzhou.aliyuncs.com. Do not use `*`, a scheme, a path,
    # an internal endpoint, or leave this placeholder in a deployed file. Keep
    # the bucket private; this CSP exception grants browser network access only.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://__OSS_PUBLIC_HOST__; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self' blob:; img-src 'self' data: blob: https://__OSS_PUBLIC_HOST__; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self' blob:" always;
    add_header Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cache-Control $uten_maintenance_cache_control always;

    location = /api/system/maintenance {
        alias /var/lib/uten-imp-public/maintenance.json;
        default_type application/json;
        limit_except GET { deny all; }
    }
    error_page 503 /maintenance.html;
    location = /maintenance.html { alias /var/lib/uten-imp-public/maintenance.html; default_type text/html; }
    location = /maintenance.css { alias /var/lib/uten-imp-public/maintenance.css; default_type text/css; }
    location = /maintenance.js { alias /var/lib/uten-imp-public/maintenance.js; default_type application/javascript; }

    # Exact health endpoints must precede the generic Actuator deny so Flutter,
    # watchdogs and load balancers never receive SPA index.html as a false 200.
    location = /actuator/health {
        limit_req zone=uten_cloud_health_ip burst=5000 nodelay;
        proxy_pass http://uten_imp_cloud_backend/actuator/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, do not append, so a client-supplied X-Forwarded-For value
        # cannot cross the Nginx -> Spring trusted-proxy boundary.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 5s;
    }

    location = /actuator/health/liveness {
        limit_req zone=uten_cloud_health_ip burst=5000 nodelay;
        proxy_pass http://uten_imp_cloud_backend/actuator/health/liveness;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 5s;
    }

    location = /actuator/health/readiness {
        limit_req zone=uten_cloud_health_ip burst=5000 nodelay;
        proxy_pass http://uten_imp_cloud_backend/actuator/health/readiness;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 5s;
    }

    # Every other Actuator path is hidden at the gateway. Do not use ^~ on this
    # location if the exact probe locations above are later changed to regexes.
    location /actuator/ {
        return 404;
    }

    location ~ ^/api/(?:auth/(?:login|refresh|logout)|visitor/auth/(?:send-code|login|refresh|logout))$ {
        limit_req zone=uten_cloud_auth_ip burst=2000 nodelay;
        proxy_pass http://uten_imp_cloud_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    # AI recognition jobs (ADR-133): raw octet-stream customer files. Keep this
    # 16 MiB exception exact and streamed; the application enforces per-user
    # limits, a bounded reader and returns 202 immediately (work runs in the
    # background, the client polls GET /api/ai/jobs/{id} through /api/).
    location = /api/ai/jobs {
        client_max_body_size 16m;
        limit_req zone=uten_cloud_ai_jobs_ip burst=4 nodelay;
        limit_conn uten_cloud_ai_jobs_conn 2;
        limit_conn_status 429;
        proxy_pass http://uten_imp_cloud_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_request_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Workbook detect/commit is the only 10 MiB cloud API exception. It is
    # streamed to the bounded application reader and separately rate/concurrency
    # limited so ordinary JSON and OSS attachment policy remain unchanged.
    location ~ ^/api/master/goods/import/(?:detect|commit)$ {
        client_max_body_size 10m;
        limit_req zone=uten_cloud_goods_import_ip burst=4 nodelay;
        limit_conn uten_cloud_goods_import_conn 2;
        limit_conn_status 429;
        proxy_pass http://uten_imp_cloud_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # Encrypted exports are assembled before their first response byte and use
    # the client's two-minute budget without weakening ordinary API requests.
    location ~ ^/api/.*/export$ {
        limit_req zone=uten_cloud_api_ip burst=500 nodelay;
        proxy_pass http://uten_imp_cloud_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 120s;
    }

    # Test reset is never a cloud capability, including future system-test routes.
    # Deny matrix-parameter variants before generic API proxy locations.
    location ~ "^/api/system-test(?:[;/]|$)" { return 404; }
    # Documentation and hidden files must never fall through to the SPA.
    location ~* "^/(?:swagger-ui(?:[./;]|$)|swagger-resources(?:[;/]|$)|v[23]/api-docs(?:[.;/]|$))" { return 404; }
    location ~ /\.(?!well-known(?:/|$)) { return 404; }
    location = /api/system-test { return 404; }
    location ^~ /api/system-test/ { return 404; }

    # Only a client-release package PUT may use the 512 MiB body budget.
    # Application authorization, step-up, streamed size/hash checks stay authoritative.
    location ~ ^/api/admin/client-releases/[0-9A-Fa-f-]+/package$ {
        if ($request_method !~ ^(PUT|OPTIONS)$) { return 405; }
        client_max_body_size 512m;
        client_body_timeout 1800s;
        limit_req zone=uten_cloud_api_ip burst=10 nodelay;
        proxy_pass http://uten_imp_cloud_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    # A published client package is streamed after the backend authorizes its ID.
    # Do not cache a package: withdrawal and account policy must apply to the next request.
    location ~ ^/api/client-updates/[0-9A-Fa-f-]+/download$ {
        if ($request_method !~ ^(GET|HEAD|OPTIONS)$) { return 405; }
        limit_req zone=uten_cloud_api_ip burst=100 nodelay;
        proxy_pass http://uten_imp_cloud_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_cache off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        send_timeout 1800s;
    }

    location /api/ {
        limit_req zone=uten_cloud_api_ip burst=500 nodelay;
        proxy_pass http://uten_imp_cloud_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    # Version-pinned fallback fonts are immutable and must never fall through
    # to index.html when a requested glyph asset is missing.
    location ^~ /fallback_fonts/ {
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    location = /version.json {
        try_files $uri =503;
        expires -1;
    }

    # Flutter Web SPA entry and client-side routes.
    location / {
        if (-f /var/lib/uten-imp-public/updating) { return 503; }
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
