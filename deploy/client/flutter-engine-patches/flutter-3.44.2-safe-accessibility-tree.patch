+bool ValidateTransaction(const ui::AXTreeUpdate& snapshot,
+                         const std::optional<ui::AXTreeUpdate>& removal,
+                         const ui::AXTreeUpdate& update) {
+  // AXTree::Unserialize is destructive on failure. A preview must have no
+  // bridge/platform observers and must never be reused after a failed update.
