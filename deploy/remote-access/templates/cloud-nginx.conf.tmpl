# Complete dedicated Nginx config; employee TLS is NEVER terminated on this host.
load_module /usr/lib/nginx/modules/ngx_stream_module.so;
pid /run/uten-remote/nginx.pid;
error_log stderr warn;
worker_processes 2;
events { worker_connections 1024; }
stream {
    log_format remote_transport '$time_iso8601 peer=$remote_addr status=$status bytes_in=$bytes_received bytes_out=$bytes_sent duration=$session_time';
    access_log /var/log/uten-remote/transport.log remote_transport;
    limit_conn_zone $binary_remote_addr zone=remote_cloud_conn:10m;
    server {
        listen 0.0.0.0:443;
        limit_conn remote_cloud_conn 32;
        proxy_pass @@COMPANY_WIREGUARD_IPV4@@:8443;
        proxy_connect_timeout 3s;
        proxy_timeout 600s;
        proxy_next_upstream off;
        proxy_socket_keepalive on;
        tcp_nodelay on;
        # Outer, machine-to-machine TLS encloses the unmodified employee TLS.
        proxy_ssl on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_certificate /etc/uten-remote/tls/cloud-client.crt;
        proxy_ssl_certificate_key /etc/uten-remote/tls/cloud-client.key;
        proxy_ssl_trusted_certificate /etc/uten-remote/tls/transport-server-ca.crt;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 1;
        proxy_ssl_server_name on;
        proxy_ssl_name @@TRANSPORT_SERVER_NAME@@;
        proxy_ssl_session_reuse on;
        # No PROXY protocol, public-domain certificate, HTTP listener or LAN routing.
    }
}
