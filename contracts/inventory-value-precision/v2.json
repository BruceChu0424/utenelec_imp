{
  "version": 2,
  "purpose": "stock.value.interval",
  "quantityFractionDigits": 24,
  "bookFractionDigits": 30,
  "rule": "Stored v1 results retain their original cumulative ROUND4 proof. New v2 values retain finite digits; nonterminating or field-limited cumulative endpoints require an explicit policy. A final slice takes the same source's actual remainder. Frozen policies precede unrelated current headers.",
  "cases": [
    {"id":"finite-24","value":"1.123456789012345678901234","from":"0","to":"1","denominator":"2","precisionVersion":2,"expected":"0.561728394506172839450617"},
