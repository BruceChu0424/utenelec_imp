# Uten IMP 后端环境变量示例。
# 复制为 .env 并填真实值；.env 不进版本库。
# 生产环境应通过服务器环境变量/密钥管理(Vault)注入，而非本文件。

# 本地开发必须显式使用 dev；生产设为 prod（遗漏时服务端默认按 prod fail-closed）。
UTEN_PROFILE=dev

# === 数据库 ===
UTEN_DB_URL=jdbc:postgresql://localhost:5432/uten_imp
UTEN_DB_USER=uten
UTEN_DB_PASSWORD=uten
# 按 PostgreSQL max_connections、应用副本数和慢查询容量共同核算；不要简单随实例数放大。
UTEN_DB_POOL_MAX=20
UTEN_DB_POOL_MIN_IDLE=2
UTEN_DB_CONNECTION_TIMEOUT_MS=10000
UTEN_DB_IDLE_TIMEOUT_MS=600000
UTEN_DB_MAX_LIFETIME_MS=1800000
# 仅首次接管“已有结构但没有 flyway_schema_history”的受控数据库时临时开启。
UTEN_FLYWAY_BASELINE_ON_MIGRATE=false

# === HTTP 请求边界 ===
# JSON（包括 chunked）默认最多 1 MiB。multipart/二进制上传应由网关和各上传接口单独限流、限尺寸并流式处理。
UTEN_MAX_JSON_BODY_BYTES=1048576

# === JWT ===
# 至少 256 位（32 字节）。生产务必换强随机串。
UTEN_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes-long
# 每个环境唯一；服务端同时校验签名、过期时间和 issuer。生产需另设生产专用值。
UTEN_JWT_ISSUER=uten-imp-dev

# === pgcrypto 主密钥（PII 字段加密）===
# 用于身份证/手机/银行卡/薪资的 pgp_sym_encrypt。
# 生产放 Vault/KMS，版本化（密文前缀 v<version>:），轮换后旧密钥放 pgp-legacy-keys 解历史密文。
UTEN_PGP_MASTER_KEY=replace-with-strong-master-key
UTEN_PGP_KEY_VERSION=1

# === HMAC 密钥（身份证号查重等确定性哈希，不可逆）===
UTEN_HMAC_KEY=replace-with-strong-hmac-key

# === CORS ===
# 逗号分隔的前端来源白名单（公司内网 + Web origin）
UTEN_CORS_ORIGINS=http://localhost:53764,http://localhost:8080

# === 生产反向代理信任边界 ===
# Java 正则，仅允许实际反向代理的源 IP；生产建议收窄为负载均衡器/网关的精确地址。
# 应用 8080 端口还必须由防火墙或容器网络限制为仅该代理可访问。
UTEN_TRUSTED_PROXY_REGEX=10\..*|192\.168\..*|172\.(1[6-9]|2[0-9]|3[0-1])\..*|127\..*|::1

# === 引导超管 ===
# 仅首次启动由 ApplicationRunner 创建 admin 账号用；首登强制改密。
# 密码密封交付 IT 负责人，首登即改。
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-one-time-random-password-at-least-12-characters

# === 访客短信验证码 ===
# 网关：log（开发期模拟且不记录验证码）/ aliyun（阿里云）
UTEN_SMS_PROVIDER=log
# 阿里云（provider=aliyun 时必填）
UTEN_SMS_ACCESS_KEY_ID=
UTEN_SMS_ACCESS_KEY_SECRET=
UTEN_SMS_SIGN_NAME=
UTEN_SMS_TEMPLATE_CODE=
UTEN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
