* text=auto
# The approved public CA is pinned by its exact PEM bytes on every platform.
assets/security/uten-imp-root-ca.crt -text
third_party/desktop_drop/** text eol=lf
third_party/device_info_plus/** text eol=lf

/.gitattributes text eol=lf
/pubspec.lock text eol=lf
server/.mvn/maven.config text eol=lf

# Flutter rewrites native plugin registrants with LF on every platform.
linux/flutter/generated_plugin_registrant.* text eol=lf
linux/flutter/generated_plugins.cmake text eol=lf
macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
windows/flutter/generated_plugin_registrant.* text eol=lf
windows/flutter/generated_plugins.cmake text eol=lf

*.dart text eol=lf
assets/workers/uten_pdf_worker.js text eol=lf
web/maintenance.js text eol=lf
web/maintenance.css text eol=lf
*.arb text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
# Rebuildable engine patches use portable zero-context diffs with pinned hashes.
deploy/client/flutter-engine-patches/*.patch text eol=lf
*.html text eol=lf
*.tmpl text eol=lf
*.cjs text eol=lf
*.prisma text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.example text eol=lf
# Linux host templates include extensionless apt configuration files.
deploy/simple/host/* text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.ttf binary
# Font manifests pin these license bytes too; Windows checkout must preserve LF.
assets/fonts/*.txt text eol=lf
# Runtime provenance compares checkout bytes with the reviewed Git objects.
services/material_forecast/requirements.in text eol=lf
services/material_forecast/requirements*.txt text eol=lf
services/material_forecast/runtime-locks/*.lock text eol=lf
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
