# Root-owned persistent-volume identity and emergency capacity contract.
# The fresh-host installer records the observed UUID/FSTYPE values. Do not copy
# these placeholders to production and do not point either path at the root FS.
STATE_FS_UUID=__STATE_FILESYSTEM_UUID__
STATE_FS_TYPE=__STATE_FILESYSTEM_TYPE__
BACKUP_FS_UUID=__BACKUP_FILESYSTEM_UUID__
BACKUP_FS_TYPE=__BACKUP_FILESYSTEM_TYPE__
STATE_MIN_FREE_MIB=4096
BACKUP_MIN_FREE_MIB=8192
