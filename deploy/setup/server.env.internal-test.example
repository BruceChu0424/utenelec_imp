# Uten IMP internal ERP test server. Copy to a root-only pending file, replace
# every REPLACE_* token with a generated/approved value, validate, then install
# as /etc/uten-imp/server.env. Never source this file in a shell.
UTEN_PROFILE=internal-test
UTEN_DEPLOYMENT_SITE=local
UTEN_LOCAL_ALLOWED_CIDRS=127.0.0.0/8,REPLACE_EXACT_OFFICE_CIDR
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

UTEN_DB_URL=jdbc:postgresql://127.0.0.1:5432/uten_imp
UTEN_DB_USER=uten
UTEN_DB_PASSWORD=REPLACE_GENERATED_DATABASE_PASSWORD
SPRING_FLYWAY_ENABLED=false

# Generate an independent random value of at least 32 characters before installation.
UTEN_JWT_SECRET=REPLACE_X
UTEN_JWT_ISSUER=uten-imp-internal-test
# 仅指定高风险、非计算型 PII/敏感快照；不用于金额/数量/汇率等 NUMERIC 字段。
UTEN_PGP_MASTER_KEY=REPLACE_GENERATED_PGP_MASTER_KEY_AT_LEAST_32_BYTES
UTEN_PGP_KEY_VERSION=1
# 身份证号查重等不可逆确定性摘要；必须与 PGP 密钥分离。
UTEN_HMAC_KEY=REPLACE_GENERATED_HMAC_KEY_AT_LEAST_32_BYTES

UTEN_CORS_ORIGINS=https://REPLACE_INTERNAL_DNS_NAME
UTEN_REQUIRE_HTTPS=true
UTEN_SSL_ENABLED=false
UTEN_TRUSTED_PROXY_REGEX=127[.].*|::1
UTEN_SWAGGER_ENABLED=false

UTEN_BOOTSTRAP_ADMIN_RETIRED=false
BOOTSTRAP_ADMIN_LOGIN=REPLACE_APPROVED_BOOTSTRAP_ADMIN_LOGIN
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_GENERATED_ONE_TIME_BOOTSTRAP_PASSWORD
UTEN_SMS_PROVIDER=disabled
UTEN_SMS_EXPOSE_CODE=false
UTEN_POLICY_INTELLIGENCE_ENABLED=false
UTEN_LEGACY_ENABLED=false

UTEN_STORAGE_PROVIDER=local
UTEN_STORAGE_LOCAL_DIR=/data/uten-imp/attachments
UTEN_ATTACHMENT_UPLOADS_ENABLED=false
UTEN_ATTACHMENT_SCANNER_PROVIDER=disabled
UTEN_ATTACHMENT_RECONCILIATION_ENABLED=false
UTEN_STORAGE_MAX_BYTES=26214400
UTEN_STORAGE_PRESIGN_EXPIRY=300
