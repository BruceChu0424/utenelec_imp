# 数据库连接 (本地用 SQLite; 服务器可换 PostgreSQL: postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# JWT 签名密钥 (生产环境务必改成长随机串, 可用: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# 初始管理员账号 (仅首次 npm run db:seed 生效; 之后请在后台修改密码)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="uten2024"

# 站点对外域名 (生成 sitemap / 绝对链接用)
SITE_URL="http://localhost:3000"
