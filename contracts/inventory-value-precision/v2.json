    {"id":"new-explicit-24-tail","value":"100","from":"1","to":"11","denominator":"11","precisionVersion":2,"choice":{"scale":24,"rounding":"DOWN"},"expected":"90.909090909090909090909091"},
    {"id":"new-explicit-half-up","value":"1.0001","from":"0","to":"1","denominator":"3","precisionVersion":2,"choice":{"scale":4,"rounding":"HALF_UP"},"expected":"0.3334"},
    {"id":"full-source-needs-no-choice","value":"100.123456789012345678901234","from":"0","to":"3","denominator":"3","precisionVersion":2,"expected":"100.123456789012345678901234"},
    {"id":"zero-width-needs-no-choice","value":"1","from":"0","to":"0","denominator":"3","precisionVersion":2,"expected":"0"},
    {"id":"complete-product-48-needs-choice","value":"0.000000000000000000000001","from":"0","to":"0.000000000000000000000001","denominator":"1","precisionVersion":2,"required":"PRECISION_LIMIT"},
    {"id":"complete-product-48-explicit-30-down","value":"0.000000000000000000000001","from":"0","to":"0.000000000000000000000001","denominator":"1","precisionVersion":2,"choice":{"scale":30,"rounding":"DOWN"},"expected":"0"}
