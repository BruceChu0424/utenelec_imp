    {"id":"finite-ignores-unused-zero-choice","value":"1.123456789012345678901234","from":"0","to":"1","denominator":"2","precisionVersion":2,"choice":{"scale":0,"rounding":"DOWN"},"expected":"0.561728394506172839450617"},
    {"id":"legacy-prefix","value":"1.0001","from":"0","to":"1","denominator":"3","precisionVersion":1,"expected":"0.3334"},
    {"id":"legacy-tail","value":"1.0001","from":"1","to":"3","denominator":"3","precisionVersion":1,"expected":"0.6667"},
    {"id":"new-repeating-requires-choice","value":"1.0001","from":"0","to":"1","denominator":"3","precisionVersion":2,"required":"NON_TERMINATING"},
