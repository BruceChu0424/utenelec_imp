* text=auto

*.dart text eol=lf
*.arb text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.example text eol=lf
# Linux host templates include extensionless apt configuration files.
deploy/simple/host/* text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.ttf binary
# Font manifests pin these license bytes too; Windows checkout must preserve LF.
assets/fonts/*.txt text eol=lf
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
