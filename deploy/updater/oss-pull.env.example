# Copy with sudoedit to /etc/uten-imp-updater/oss-pull.env.
# Never place real values in Git, chat, shell history, or deployment logs.
OSS_ACCESS_KEY_ID=REPLACE_WITH_GET_ONLY_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=REPLACE_WITH_GET_ONLY_ACCESS_KEY_SECRET
OSS_BUCKET=replace-with-private-release-bucket
OSS_ENDPOINT=https://oss-cn-example.aliyuncs.com
# OSS_SECURITY_TOKEN=REPLACE_WITH_SHORT_LIVED_STS_TOKEN
