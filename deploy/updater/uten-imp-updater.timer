[Unit]
Description=Retired Uten IMP automatic signed release staging timer
# Keep the legacy unit inert even if it is accidentally enabled. The root
# directory always exists. Authorized manual checks use the operations service.
ConditionPathExists=!/

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
RandomizedDelaySec=60
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
