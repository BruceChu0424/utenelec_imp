[Unit]
Description=Explicitly authorized Uten IMP update job
After=network-online.target postgresql@16-main.service
Wants=network-online.target
OnFailure=uten-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0700 /run/uten-imp-updater
ExecStart=/usr/bin/python3 -I /usr/local/lib/uten-imp/host_operations.py worker
# This unit is independent of uten-imp.service; restarting the ERP cannot kill it.
# Bounds: check6m + stage60m + backup40m + verify40m + TOC1m + cutover45m
# + stable health and local preflight; retain a margin before the outer watchdog.
TimeoutStartSec=240min
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/uten-imp /run/uten-imp-updater /var/lib/uten-imp-operations
ReadWritePaths=-/srv/uten-backup/pre-activation -/data/uten-imp-backups/paired -/var/log/uten-imp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
