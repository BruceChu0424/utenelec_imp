# Root-only merge checklist for an existing /etc/uten-imp/server.env.
# Do NOT replace the whole live file with this example: preserve JWT, PGP, HMAC,
# database, bootstrap, and other existing secrets. Use sudoedit, merge the keys
# below, validate, then remove obsolete local-storage keys after data cutover.
#
# Bootstrap credential state is also fail-closed. Before an empty-database first
# start, set UTEN_BOOTSTRAP_ADMIN_RETIRED=false and use only the phase3-generated
# 48-character lowercase-hex secret. After the forced password change over
# accepted HTTPS, independently verify the old credential is rejected and the
# users row has must_change_password=false plus last_password_changed_at set.
# Then, in an approved maintenance window, set BOOTSTRAP_ADMIN_PASSWORD empty,
# set UTEN_BOOTSTRAP_ADMIN_RETIRED=true, revalidate, and restart only through the
# controlled activation path so the spent secret leaves the process environment.

# Spring Boot binds SERVER_ADDRESS/SERVER_PORT directly. UTEN_SERVER_ADDRESS is
# only mapped by the cloud profile and does not bind the local prod profile.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
UTEN_REQUIRE_HTTPS=true
UTEN_SSL_ENABLED=false
UTEN_CORS_ORIGINS=https://REPLACE_WITH_EXACT_ALLOWED_ORIGIN

# Flyway is always disabled in the backend JVM. Delete SPRING_FLYWAY_USER,
# SPRING_FLYWAY_PASSWORD, FLYWAY_USER, FLYWAY_PASSWORD and any migrator secret
# accidentally retained in this file. The separate /etc/uten-imp-migrator tree
# is created and validated by phase3; never copy its env into server.env.
SPRING_FLYWAY_ENABLED=false

# ProductionStorageSafetyGate requires all of these for the prod profile.
UTEN_STORAGE_PROVIDER=oss
UTEN_ATTACHMENT_UPLOADS_ENABLED=false
UTEN_ATTACHMENT_SCANNER_PROVIDER=disabled
UTEN_ATTACHMENT_RECONCILIATION_ENABLED=false
UTEN_OSS_ENDPOINT=https://REPLACE_WITH_PUBLIC_OSS_ENDPOINT
UTEN_OSS_STAGING_BUCKET=REPLACE_WITH_UNVERSIONED_STAGING_BUCKET
UTEN_OSS_FINAL_BUCKET=REPLACE_WITH_VERSIONED_FINAL_BUCKET
UTEN_OSS_REGION=REPLACE_WITH_REGION
UTEN_OSS_USE_INSTANCE_ROLE=false
UTEN_OSS_ACCESS_KEY_ID=REPLACE_WITH_LEAST_PRIVILEGE_RAM_ACCESS_KEY_ID
UTEN_OSS_ACCESS_KEY_SECRET=REPLACE_WITH_LEAST_PRIVILEGE_RAM_ACCESS_KEY_SECRET
UTEN_OSS_KEY_PREFIX=attachments/
UTEN_OSS_REQUIRE_VERSIONING=true

# Before activation, independently prove staging versioning is Off, final
# versioning is Enabled, the Buckets differ, and migrate/reconcile every
# existing local attachment. Upload/scanner/reconciliation remain disabled
# until their separate production acceptance. Configuration is not a cutover.
