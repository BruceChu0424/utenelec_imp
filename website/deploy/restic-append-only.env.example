# Root-only website backup writer. Values are examples, never source secrets.
RESTIC_REPOSITORY=s3:https://__WEBSITE_BACKUP_ENDPOINT__/__WEBSITE_BACKUP_BUCKET__/paired-state
RESTIC_PASSWORD_FILE=/etc/uten-website/restic-password
AWS_ACCESS_KEY_ID=__WEBSITE_APPEND_ONLY_ACCESS_KEY_ID__
AWS_SECRET_ACCESS_KEY=__SET_PRIVATELY_ON_SERVER__
UTEN_WEBSITE_RESTIC_APPEND_ONLY=true
