# Include this file from nginx's `http` context only after replacing every
# all-caps placeholder token with the real host, certificate and exact CIDRs.
#
# !!! REQUIRED BEFORE PRODUCTION !!!
# The two public-facing server blocks below require exact OFFICE_CIDR and
# approved corporate VPN CIDR values. Enforce the same boundary in the host
# firewall/security group. A public load balancer with a private source address
# would otherwise make every Internet client appear private to this Nginx host.

# These are coarse, finite IP-level flood guards, not per-user policy. A shared
# office NAT can contain 1,000 recovering clients: health has a separate bucket
# sized for that recovery wave, while auth accepts a bounded login/refresh burst.
# Per-account/per-phone controls remain in the application. Load-test and tune all
# three buckets with the real NAT/CGNAT topology before production.
limit_req_zone $binary_remote_addr zone=uten_health_ip:10m rate=1000r/s;
limit_req_zone $binary_remote_addr zone=uten_auth_ip:10m rate=300r/s;
limit_req_zone $binary_remote_addr zone=uten_api_ip:20m rate=3000r/m;
limit_req_zone $binary_remote_addr zone=uten_goods_import_ip:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=uten_goods_import_conn:10m;

upstream uten_imp_backend {
    # The documented on-prem topology runs App + PostgreSQL on the same host.
    # Keep 8080 loopback-only; use another explicit private address only after
    # changing the firewall and trusted-proxy review together.
    server 127.0.0.1:8080;
    keepalive 32;
}

# Loopback-only static-entry probe. The external systemd watchdog requires both
# Nginx request handling and the immutable current/index.html to be available.
server {
    listen 127.0.0.1:8081;
    server_name _;
    root /opt/uten-imp/current/web;
    access_log off;
    log_not_found off;

    location = /index.html {
        try_files $uri =503;
    }

    location = /version.json {
        try_files $uri =503;
        expires -1;
    }

    location / {
        return 404;
    }
}

# Dedicated-host catch-all boundaries. Unknown HTTP hosts are closed without a
# redirect, and unknown TLS SNI names are rejected during the handshake.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name __LOCAL_DOMAIN__;

    # Never reflect a caller-controlled Host header into redirects. An
    # unexpected host is rejected instead of being served by this vhost.
    if ($host != "__LOCAL_DOMAIN__") { return 444; }

    # Add further allow lines only for separately approved exact CIDRs.
    allow 127.0.0.1;
    allow ::1;
    allow __OFFICE_CIDR__;
    allow __VPN_CIDR__;
    deny all;

    return 308 https://__LOCAL_DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __LOCAL_DOMAIN__;
    server_tokens off;
    limit_req_status 429;

    if ($host != "__LOCAL_DOMAIN__") { return 444; }

    # Keep this identical to the port-80 boundary above.
    # Keep the separate 127.0.0.1:8081 watchdog server above unchanged.
    allow 127.0.0.1;
    allow ::1;
    allow __OFFICE_CIDR__;
    allow __VPN_CIDR__;
    deny all;

    ssl_certificate __TLS_CERT_PATH__;
    ssl_certificate_key __TLS_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;
    ssl_session_cache shared:UTEN_SSL:10m;
    ssl_session_timeout 1d;

    # `current` is an atomically replaced symlink to an immutable versioned
    # release directory. Never copy files through this path in place.
    root /opt/uten-imp/current/web;
    index index.html;
    client_max_body_size 2m;

    # Keep the gateway and Spring request-header budgets aligned. Two 8 KiB
    # large buffers cap the exceptional total at roughly 16 KiB while each
    # individual field must still fit in 8 KiB. Do not raise this without a
    # measured header-budget review.
    client_header_buffer_size 4k;
    large_client_header_buffers 2 8k;

    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 45s;

    # Compress the large Flutter JavaScript/Wasm payloads for mainland mobile
    # and cross-carrier links. Brotli may be enabled at the CDN/load balancer
    # only after its module and cache-variation behaviour are verified.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/wasm
        image/svg+xml
        text/css
        text/plain;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # REQUIRED: both local and cloud Web builds upload to the same private OSS
    # bucket. Replace __OSS_PUBLIC_HOST__ with that bucket's exact public
    # virtual-host name; keep the matching OSS CORS origins equally narrow.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://__OSS_PUBLIC_HOST__; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self' blob:; img-src 'self' data: blob: https://__OSS_PUBLIC_HOST__; manifest-src 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self' blob:" always;
    add_header Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Browser recovery probes Actuator outside the /api application namespace.
    # Keep this exact route before the SPA fallback; otherwise index.html could
    # return 200 and falsely claim that a stopped backend is healthy.
    location = /actuator/health {
        limit_req zone=uten_health_ip burst=5000 nodelay;
        proxy_pass http://uten_imp_backend/actuator/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite rather than append caller-controlled forwarding headers.
        # If a trusted LB is added, first normalize $remote_addr with Nginx's
        # real_ip module and an exact set_real_ip_from allowlist.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 5s;
    }

    # Spring Boot exposes these probe groups when health probes are enabled.
    # Proxy them explicitly so the SPA fallback can never return index.html/200
    # and make an orchestrator believe a stopped backend is healthy.
    location ~ ^/actuator/health/(?:liveness|readiness)$ {
        limit_req zone=uten_health_ip burst=5000 nodelay;
        proxy_pass http://uten_imp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 5s;
    }

    # Do not use ^~ here: the exact root and regex liveness/readiness locations
    # above must win. Every other Actuator path is denied at the gateway instead
    # of falling through to Flutter's SPA index.html with a false 200.
    location /actuator/ {
        return 404;
    }

    location ~ ^/api/(?:auth/(?:login|refresh|logout)|visitor/auth/(?:send-code|login|refresh|logout))$ {
        limit_req zone=uten_auth_ip burst=2000 nodelay;
        proxy_pass http://uten_imp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    # Goods workbooks use raw octet-stream uploads. Keep this exception exact:
    # ordinary JSON remains capped at 2 MiB. The application independently
    # stops unknown-length streams at the first byte beyond 10 MiB.
    location ~ ^/api/master/goods/import/(?:detect|commit)$ {
        client_max_body_size 10m;
        limit_req zone=uten_goods_import_ip burst=4 nodelay;
        limit_conn uten_goods_import_conn 2;
        limit_conn_status 429;
        proxy_pass http://uten_imp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # Only local-storage raw uploads need the attachment-sized request body.
    # Production should normally use the shared private OSS bucket, but this
    # exact route keeps a deliberate local provider consistent with the 25 MiB
    # application limit without weakening ordinary JSON endpoints.
    location ~ ^/api/attachments/raw/[A-Za-z0-9._-]+$ {
        client_max_body_size 25m;
        limit_req zone=uten_api_ip burst=100 nodelay;
        proxy_pass http://uten_imp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Encrypted workbook endpoints build the complete response before sending
    # the first byte. Match the client's two-minute download budget without
    # weakening ordinary API timeouts.
    location ~ ^/api/.*/export$ {
        limit_req zone=uten_api_ip burst=500 nodelay;
        proxy_pass http://uten_imp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 120s;
    }

    # 清空业务数据（超管专属测试端点，ADR-067 §7）是同步长请求：排水 ≤45s + 附件自动清理
    # ≤5min + 清库。精确匹配优先于下方 /api/ 前缀与正则 location，仅此路径放宽到 600s
    # （前端 ApiClient.postLongRunning 对该端点的接收超时为 10 分钟，与之对齐）。
    location = /api/system-test/business-data/reset {
        limit_req zone=uten_api_ip burst=500 nodelay;
        proxy_pass http://uten_imp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /api/ {
        limit_req zone=uten_api_ip burst=500 nodelay;
        proxy_pass http://uten_imp_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    # Flutter's version-pinned fallback fonts are immutable and fetched only
    # when a missing glyph needs them. Never route a missing font to index.html.
    location ^~ /fallback_fonts/ {
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    # Advisory metadata for already-open tabs. It must not fall through to the
    # SPA or use the immutable-asset cache policy.
    location = /version.json {
        try_files $uri =503;
        expires -1;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
