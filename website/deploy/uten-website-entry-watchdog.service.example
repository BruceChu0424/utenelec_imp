[Unit]
Description=Reconcile Uten website process and fail-closed Nginx entry
After=network-online.target uten-website-boot-gate.service
Wants=network-online.target
Requires=uten-website-boot-gate.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/uten-website/uten-website-boot-guard reconcile
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
# Narrow child carve-outs become nested bind mounts under ProtectSystem=strict
# and are intentionally rejected by validate-storage.
ReadWritePaths=/etc/nginx/snippets /run/uten-website-release /var/lib/uten-website /var/backups/uten-website /var/log/nginx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
UMask=0077
