<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Uten.Legacy.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Uten.Tokens.g.xaml"/></ResourceDictionary.MergedDictionaries>
  <FontFamily x:Key="Uten.Font">pack://application:,,,/Assets/#Noto Sans SC, Microsoft YaHei, Segoe UI</FontFamily>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource Uten.Font}"/><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Body}"/><Setter Property="Foreground" Value="{StaticResource Uten.Text}"/><Setter Property="Background" Value="{StaticResource Uten.Background}"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
  <Style x:Key="Uten.Workspace" TargetType="UserControl"><Setter Property="FontFamily" Value="{StaticResource Uten.Font}"/><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Body}"/><Setter Property="Foreground" Value="{StaticResource Uten.Text}"/><Setter Property="Background" Value="{StaticResource Uten.Background}"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Uten.PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Title}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Uten.SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Subtitle}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <ControlTemplate x:Key="Uten.InputTemplate" TargetType="Control">
    <Border x:Name="Frame" CornerRadius="{StaticResource Uten.Radius.Control}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Uten.PrimaryBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Uten.Error}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Uten.FormControl" TargetType="Control"><Setter Property="FontFamily" Value="{StaticResource Uten.Font}"/><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Input}"/><Setter Property="Padding" Value="{StaticResource Uten.Padding.Input}"/><Setter Property="MinHeight" Value="{StaticResource Uten.Height.Input}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource Uten.Text}"/><Setter Property="BorderBrush" Value="{StaticResource Uten.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource Uten.Surface}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Uten.FormControl}"><Setter Property="Template" Value="{StaticResource Uten.InputTemplate}"/></Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource Uten.FormControl}"><Setter Property="Template" Value="{StaticResource Uten.InputTemplate}"/></Style>
  <Style x:Key="Uten.CompactInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="{StaticResource Uten.Height.Compact}"/><Setter Property="Padding" Value="{StaticResource Uten.Padding.Filter}"/><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Compact}"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Uten.FormControl}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Uten.Radius.Control}"/>
      <ToggleButton Focusable="False" IsTabStop="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
      <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False"/>
      <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Uten.Muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><controls:RoundedSurface Background="{StaticResource Uten.Surface}" BorderBrush="{StaticResource Uten.Border}" BorderThickness="1" CornerRadius="{StaticResource Uten.Radius.Menu}" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></controls:RoundedSurface></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Uten.PrimaryBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="{StaticResource Uten.Padding.Filter}"/><Setter Property="Foreground" Value="{StaticResource Uten.Text}"/><Setter Property="Background" Value="{StaticResource Uten.Surface}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource Uten.PrimaryLight}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Uten.Selected}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="{StaticResource Uten.Padding.Button}"/><Setter Property="MinHeight" Value="{StaticResource Uten.Height.Standard}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="{StaticResource Uten.Font}"/><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Body}"/><Setter Property="Background" Value="{StaticResource Uten.Surface}"/><Setter Property="Foreground" Value="{StaticResource Uten.Text}"/><Setter Property="BorderBrush" Value="{StaticResource Uten.Border}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="{StaticResource Uten.Radius.Control}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Uten.PrimaryBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Uten.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Uten.PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource Uten.PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Uten.PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource Uten.PrimaryButton}"><Setter Property="MinHeight" Value="{StaticResource Uten.Height.Primary}"/></Style>
  <Style x:Key="Uten.CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="{StaticResource Uten.Caption.HitWidth}"/><Setter Property="Height" Value="{StaticResource Uten.Height.Caption}"/><Setter Property="MinHeight" Value="{StaticResource Uten.Height.Caption}"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{StaticResource Uten.Caption.IconSize}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Ellipse Width="{StaticResource Uten.Caption.Diameter}" Height="{StaticResource Uten.Caption.Diameter}" Fill="{TemplateBinding Background}"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="FontSize" Value="{StaticResource Uten.FontSize.Value}"/><Setter Property="Background" Value="{StaticResource Uten.Surface}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{StaticResource Uten.Surface}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Uten.Border}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/></Style>
  <Style TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Uten.Selected}"/><Setter Property="Foreground" Value="{StaticResource Uten.Text}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Uten.Text}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="{StaticResource Uten.Height.Input}"/><Setter Property="Background" Value="{StaticResource Uten.Background}"/><Setter Property="Foreground" Value="{StaticResource Uten.Muted}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="BorderBrush" Value="{StaticResource Uten.Border}"/></Style>
</ResourceDictionary>
