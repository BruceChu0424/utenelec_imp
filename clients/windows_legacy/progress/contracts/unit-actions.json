  "writeContracts": {
    "create": {
      "method": "POST",
      "path": "/api/master/units",
      "permission": "unit:create",
      "required": [
        "name"
      ],
      "optional": [
        "code",
        "status",
        "measurementDimension",
        "massUnitCode"
      ],
      "extraStatusGrant": "nondefault explicit status requires unit:status",
      "measurementInference": "both keys absent permits server weight-name inference; explicitnull disables inference",
      "internalImportService": "goods:import is service/internal compatibility, not public HTTP permission",
      "version": "none",
      "receipt": "none"
    },
    "update": {
      "method": "PUT",
      "path": "/api/master/units/{UUID}",
      "controllerGate": "any(unit:edit,unit:status)",
      "effectiveServiceGate": "unit:edit always; changed status additionally unit:status",
      "fullFields": [
        "name",
        "status"
      ],
      "code": "empty/absent keeps existing",
      "measurement": "presence aware only for two measurement keys",
      "version": "none",
      "receipt": "none"
    },
    "status": {
      "method": "PATCH",
      "path": "/api/master/units/{UUID}/status",
      "permission": "unit:status",
      "body": {
        "status": "使用|禁用",
        "version": "optional Long; UnitService ignores"
      },
      "concurrency": "pessimistic row refresh, no expected-version enforcement",
      "sourcePageActualPath": "single and multi source UI use POST batch-status"
    },
    "inline": {
      "method": "PATCH",
      "path": "/api/master/inline-edit/units/{UUID}",
      "pageFields": [
        "name",
        "status"
      ],
      "apiFields": [
        "name",
        "status",
        "measurementDimension",
        "massUnitCode"
      ],
      "body": "expected original values perchanged field + changes",
      "guards": "unit:view/edit; status grant ifchanged; employee-bound/nonvisitor/unlocked/notmustchangepw/nonimpersonated",
      "version": "changed-field compare under NOWAIT lock, not monotonic Unit version",
      "receipt": "none"
    },
    "batch": {
      "status": "POST /api/master/units/batch-status",
      "delete": "POST /api/master/units/batch-delete",
      "maxItems": 500,
      "item": "{id:UUID,version?:Long}; Unit kind versioned=false",
      "result": "{succeeded,failed,results:[{id,label,ok,reason}]} after UUIDdedupe",
      "receipt": "none"
    }
  },
  "fieldPresenceCases": [
    {
      "operation": "update",
      "before": "MASS/KG",
      "input": "both keys omitted",
      "expected": "MASS/KG preserved"
    },
    {
      "operation": "create",
      "before": "name kg",
      "input": "both keys omitted",
      "expected": "server parser may infer MASS/KG"
    },
    {
      "operation": "create",
      "before": "name kg",
      "input": "both explicit null",
      "expected": "no inference; unset"
    },
    {
      "operation": "update",
      "before": "MASS/KG",
      "input": "massUnitCode:null only",
      "expected": "MASS retained, mass code cleared unless in-use guard rejects"
    },
    {
      "operation": "update",
      "before": "MASS/KG",
      "input": "measurementDimension:COUNT, mass omitted",
      "expected": "clear mass code unless in-use guard rejects"
    },
    {
      "operation": "update",
      "before": "any",
      "input": "COUNT+KG",
      "expected": "validation rejected"
    },
    {
      "operation": "update",
      "before": "MASS/KG",
      "input": "both explicit null",
      "expected": "delete measurement profile unless in-use guard rejects"
    },
    {
      "operation": "update",
      "before": "baseline status",
      "input": "status omitted/null",
      "expected": "apply attempts null; NOT presence-preserve; ordinary edit must include baseline status"
    },
    {
      "operation": "update",
      "before": "existing code",
      "input": "code blank/null/omitted",
      "expected": "retain existing code"
    }
  ],
  "measurementAuthority": {
    "dimensions": [
      "COUNT",
      "MASS",
      "LENGTH",
      "AREA",
      "VOLUME",
      "OTHER"
    ],
    "massCodes": [
      "G",
      "KG",
      "T",
      "JIN",
      "LB",
      "OZ"
    ],
    "normalization": "trim/uppercase; empty→null",
    "inUse": "changing into/outof MASS or MASS code with related goods nonzero stock/anymovement (includingdeleted goods) ->409",
    "unchangedNoop": true,
    "nonMassToNonMass": "not subject to MASS accounting restriction",
    "doNotReimplementWeightConversion": true
  },
  "coreMutationIntegration": {
    "interface": "CaptureMutationOwner -> PrepareMutation(UnitCreate|UnitUpdate|UnitStatus, stableLocalUUID, rawBodyJson, owner,resourceId?,observedStatus?) -> MutateAsync",
    "outcomes": [
      "NotSent",
      "Confirmed",
      "Rejected",
      "Unknown"
    ],
    "rawBodyFrozen": true,
    "localRequestIdIsServerIdempotencyKey": false,
    "statusVersionContract": "AcceptedButIgnored; EnforcesExpectedVersion=false",
    "automatic401OrStepUpReplay": false,
    "durableMutationJournalAvailableAtHandshake": false,
    "initialCoverage": "three typed transport/fence actions only; not all 28 groups, not complete Unit",
    "descriptorSingleAttempt": true,
    "explicitRejectionNextDecision": "new user decision and new local request ID; never replay old descriptor",
    "unconfirmedDatasetBlocksPrepare": true,
    "serverRequestIdHeader": null,
    "serverRequestIdBodyField": null
  },
  "unknownReconciliation": {
    "create": "freeze originalintent; search/name/code/history only manualevidence, no automaticownership or resend",
    "updateOrStatus": "UUID detail proves currentstate, not originalcommand causality; matching values are not receipt",
    "batch": "retain originalset and known peritemresults; no blind resend of confirmed/unknownitems",
    "personalUndoRedo": "opId+expectedOperationVersion+direction maypermit deterministic nextversion/state proof only after owningconcurrency/eviction tests",
    "recordRestore": "expectedHead protects restore only; no assumed generic receipt",
    "exportJobs": "originaljob UUID has real GET/cancel/download state; job success isnot filedelivery"
  },
  "gaps": [
    {
      "id": "UNIT-GAP-01",
      "title": "No Unit whole-record version in read/save; status andbatch ignoreUnit version",
      "blocks": "crossclient stale full edit DoD"
    },
    {
      "id": "UNIT-GAP-02",
      "title": "No server commandreceipt/idempotency for create/update/status",
      "blocks": "safe automated unknown reconciliation"
    },
    {
      "id": "UNIT-GAP-03",
      "title": "WPF durablejournal/draft absent in initialMutation",
      "blocks": "restart/close/update retention"
    },
    {
      "id": "UNIT-GAP-04",
      "title": "Print button follows view reads; exportPermission only gates embeddedexport",
      "blocks": "claim unit:export already protects print; owning policy decision/parity needed"
    },
    {
      "id": "UNIT-GAP-05",
      "title": "three actions omit inline/batch/history/export/print/draftcomplete paths",
      "blocks": "Unit/FLOW done"
    }
  ],
  "requiredIncrementPlan": [
    {
      "stage": "P1",
      "implemented": false,
      "scope": "server/DTO/DB",
      "proposal": "Authoritative monotonic Unit revision mustcover unit row + measurement profile. Emit in readDTO and compare underlock. Cover allwriters: full/inline/status/batch/history/import; do not substitute personalhistory version or measurementversion."
    },
    {
      "stage": "P2",
      "implemented": false,
      "scope": "server receipt/DB",
      "proposal": "Explicit commandidentity+presence-sensitive payload hash boundto actor/issuer/dataset; samekey+samebody returns original result; mismatchreject. Receipt and business effect atomic; scoped readonly receiptquery. New route/DTO names not yetexisting and require owning design."
    },
    {
      "stage": "P3",
      "implemented": false,
      "scope": "Dart + WPF + sharedpubliccallers",
      "proposal": "Negotiate capability; shared frozenjournal, draft and recovery adapters; sameversion/commandid andpresence semantics. Migrate allpublicedit/inline/batch/history callsites, not just one WPF form."
    },
    {
      "stage": "P4",
      "implemented": false,
      "scope": "rollout/regression",
      "proposal": "Preserve current v0/default until coordinatedrollout. Optin alone cannotstop stale old Win10 writer clobbering newstate; legacywriter policy + bothclient regression remain mandatory. No productiondeployment authorized."
    }
  ],
