[Unit]
Description=Uten IMP static entry watchdog probe
Documentation=man:systemd.service(5)
After=network-online.target nginx.service uten-imp-recovery-commit-verifier.service
Wants=network-online.target
Requires=uten-imp-recovery-commit-verifier.service

[Service]
Type=oneshot
User=root
Group=root
UnsetEnvironment=UTEN_ENTRY_WATCHDOG_URL UTEN_ENTRY_WATCHDOG_MARKER UTEN_ENTRY_WATCHDOG_FAILURE_THRESHOLD UTEN_ENTRY_WATCHDOG_SERVICE UTEN_ENTRY_WATCHDOG_STATE_DIR
RuntimeDirectory=uten-imp-entry-watchdog
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/test ! -e /var/lib/uten-imp-release/activation-failed.json
ExecStartPre=/usr/bin/test ! -e /var/lib/uten-imp-release/activation-in-progress.json
ExecStartPre=/usr/bin/test ! -e /var/lib/uten-imp-release/boot-enablement-in-progress.json
ExecStartPre=/usr/bin/test ! -e /var/lib/uten-imp-release/recovery-in-progress.json
ExecStartPre=/usr/bin/test ! -e /var/lib/uten-imp-release/internal-test-onboarding-adoption.json
ExecStartPre=/usr/bin/test ! -e /var/lib/uten-imp-release/internal-test-activation-reauthorization.json
ExecStartPre=/usr/bin/python3 -I /usr/local/libexec/uten-imp-release/recovery_ingress_gate.py
ExecStartPre=/usr/bin/test -x /usr/local/libexec/uten-imp/uten-imp-entry-watchdog
ExecStart=/usr/bin/bash /usr/local/libexec/uten-imp/uten-imp-entry-watchdog
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/usr/local/libexec/uten-imp /var/lib/uten-imp-release
ReadWritePaths=/run/uten-imp-entry-watchdog
TimeoutStartSec=15s
