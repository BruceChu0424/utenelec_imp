// Generated by wpf_install_policy.py; do not edit independently.
// Microsoft version detection: Release >= 528040 means .NET 4.8 or later.
function SelectWpfArchitecture(Major, Minor, ServicePackMajor,
  Architecture, ProductType: Integer; NetRelease: Cardinal;
  var ErrorMessage: String): String;
begin
  Result := '';
  ErrorMessage := '';
  if ProductType <> 1 then begin
    ErrorMessage := '当前验证版仅支持 Windows 7 SP1 或 Windows 8.1 工作站系统。';
    Exit;
  end;
  if Major >= 10 then begin
    ErrorMessage := '这台电脑请继续使用现有 Windows 10/11 客户端；当前兼容验证版不会安装。';
    Exit;
  end;
  if (Major = 6) and (Minor = 1) then begin
    if ServicePackMajor < 1 then begin
      ErrorMessage := 'Windows 7 需要先安装 Service Pack 1；本安装器不会自动修改系统环境。';
      Exit;
    end;
  end else if (Major = 6) and (Minor = 3) then begin
  end else begin
    ErrorMessage := '当前验证版仅支持 Windows 7 SP1 和 Windows 8.1；Windows 8.0 不支持本程序所需的 .NET Framework 4.8。';
    Exit;
  end;
  case Architecture of
    0: Result := 'x86';
    9: Result := 'x64';
  else
    ErrorMessage := '当前验证版仅提供 x86 和 x64；不支持 ARM 或无法识别的系统架构。';
    Exit;
  end;
  if NetRelease < 528040 then begin
    Result := '';
    ErrorMessage := '需要先安装 Microsoft 官方 .NET Framework 4.8（Full）。请由管理员核对系统更新及官方安装要求；本安装器不会下载或安装系统组件。';
  end;
end;
