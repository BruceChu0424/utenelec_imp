      "frames": [
        {
          "type": "page",
          "value": {
            "items": [
              {
                "id": "11111111-1111-1111-1111-111111111111",
                "code": "G-001",
                "name": "货品原文",
                "stockQtyDisplayText": "90071992547409.123456789012345678900",
                "priceDisplayText": "12.3400",
                "writable": false
              }
            ],
            "page": 1,
            "size": 100,
            "total": 1,
            "totalPages": 1,
            "readScopeVersion": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "readSnapshotRevision": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "readDataVersion": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
          }
        },
        {
          "type": "complete",
          "readScopeVersion": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "readSnapshotRevision": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "readDataVersion": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "total": 1
        }
      ],
      "expected": "success"
