# 复制到 /etc/uten-imp-updater.env（root:root 0600），逐项替换 REPLACE
# 服务器只读 OSS 用 RAM 子账号（GetObject 限 releases/* 与 LATEST.txt）

# OSS 发布桶（与 GitHub simple-release.yml 的 vars 一致）
UTEN_OSS_BUCKET=replace-with-release-bucket
UTEN_OSS_ENDPOINT=oss-cn-example.aliyuncs.com
UTEN_OSS_KEY_ID=REPLACE_WITH_READ_ONLY_KEY_ID
UTEN_OSS_KEY_SECRET=REPLACE_WITH_READ_ONLY_KEY_SECRET

# 信任：钉死的发布签名公钥（对应 GitHub secret RELEASE_SIGNING_KEY 的私钥）
UTEN_ALLOWED_SIGNERS=/etc/uten-imp-updater/allowed_signers
UTEN_SIGNER_ID=uten-imp-release
UTEN_NAMESPACE=uten-imp-release

# 安装布局与运行
UTEN_BASE=/opt/uten-imp
UTEN_APP_SERVICE=uten-imp
UTEN_HEALTH_URL=http://127.0.0.1:8080/actuator/health/readiness

# 数据库迁移激活（activate <version> 时使用）
UTEN_PG_DATABASE=uten_imp
UTEN_MIGRATOR_ENV=/etc/uten-imp/migrator.env
UTEN_BACKUP_DIR=/var/backups/uten-imp

# 纯代码版本是否自动激活（0=只暂存，全部人工 activate）
UTEN_AUTO_ACTIVATE_CODE_ONLY=1

# 保留最近 N 个已下载版本
UTEN_KEEP_RELEASES=5
