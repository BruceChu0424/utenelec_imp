# Uten IMP 后端环境变量示例。
# 复制为 .env 并填真实值；.env 不进版本库。
# 生产环境应通过服务器环境变量/密钥管理(Vault)注入，而非本文件。
# 填完变量不等于生产就绪；网络/TLS、复制、HBA、Nginx/systemd、PITR、OSS 与真实验收见 deploy/cloud/README-cloud.md。

# 本地开发显式使用 dev；本地生产使用 prod，云端生产必须同时使用 cloud,prod。
# 遗漏时服务端默认按 prod fail-closed，但这不替代显式生产配置。
UTEN_PROFILE=dev
# 部署站点：local（公司内网，默认）/ cloud（阿里云 ECS，仅 remote_access 授权账号可外网访问）。
UTEN_DEPLOYMENT_SITE=local
# 本地站点 /api 的来源网段；生产必须改成实际办公室/VPN CIDR，不要照抄宽泛示例。
UTEN_LOCAL_ALLOWED_CIDRS=127.0.0.0/8,::1/128,10.20.0.0/16

# === 数据库 ===
# docker-compose.yml 将容器 5432 映射到宿主 5433；直接启动后端时连接宿主端口。
# prod/cloud 使用非回环 PostgreSQL 时，URL 必须显式包含
# sslmode=verify-full&sslrootcert=/绝对/路径/company-root-ca.crt；本机 dev 回环不要求。
UTEN_DB_URL=jdbc:postgresql://localhost:5433/uten_imp
UTEN_DB_USER=uten
UTEN_DB_PASSWORD=uten
# 按 PostgreSQL max_connections、应用副本数和慢查询容量共同核算；不要简单随实例数放大。
UTEN_DB_POOL_MAX=20
UTEN_DB_POOL_MIN_IDLE=2
UTEN_DB_CONNECTION_TIMEOUT_MS=10000
UTEN_DB_IDLE_TIMEOUT_MS=600000
UTEN_DB_MAX_LIFETIME_MS=1800000
# 仅首次接管“已有结构但没有 flyway_schema_history”的受控数据库时临时开启。
UTEN_FLYWAY_BASELINE_ON_MIGRATE=false

# === HTTP 请求边界 ===
# JSON（包括 chunked）默认最多 1 MiB。multipart/二进制上传应由网关和各上传接口单独限流、限尺寸并流式处理。
UTEN_MAX_JSON_BODY_BYTES=1048576

# === 页面权限委派运行开关 ===
# V328 权限目录与委派验收后默认启用。紧急回退可改为 false：关闭页面权限工作台入口与
# 读写 API，并暂停负责人委派对有效权限的贡献；不会删除既有授权、收回、委派历史或审计证据。
UTEN_MANAGER_PERMISSION_DELEGATION_ENABLED=true

# === 财务资产核心落账安全门禁 ===
# 默认且当前必须保持 false。初始确认、处置、待摊提前终止的专用反冲/状态恢复和 UAT
# 未完成前，任何环境都不得把此模板改为 true；详见 docs/数据迁移/51 与 ADR-018。
UTEN_FINANCE_ASSET_POSTED_WORKFLOWS_ENABLED=false

# === 定时任务与审计留存 ===
# 留存月数由「系统设置 → 审计与留存」管理；这里仅控制任务开关、执行时间和调度线程池。
UTEN_AUDIT_RETENTION_ENABLED=true
UTEN_AUDIT_RETENTION_CRON=0 17 3 * * *
UTEN_SCHEDULING_POOL_SIZE=4

# === JWT ===
# 至少 256 位（32 字节）。生产务必换强随机串。
UTEN_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes-long
# 每个环境唯一；同一生产环境的本地/云端两个入口必须使用同一个 issuer 与密钥。
# 开发、预发布、生产之间仍必须不同。
UTEN_JWT_ISSUER=uten-imp-dev

# === pgcrypto 主密钥（指定高风险、非计算型 PII/敏感快照）===
# 用于身份证/手机/银行卡/薪资等明确纳入保护的字段；不是整库加密。
# 金额/数量/汇率/余额保持 NUMERIC，磁盘、备份与 TLS 保护另行配置。
# 生产放 Vault/KMS，版本化（密文前缀 v<version>:），轮换后旧密钥放 pgp-legacy-keys 解历史密文。
UTEN_PGP_MASTER_KEY=replace-with-strong-master-key
UTEN_PGP_KEY_VERSION=1

# === HMAC 密钥（身份证号查重等确定性哈希，不可逆）===
UTEN_HMAC_KEY=replace-with-strong-hmac-key

# === CORS ===
# 逗号分隔的前端来源白名单（公司内网 + Web origin）
UTEN_CORS_ORIGINS=http://localhost:53764,http://localhost:8080
# 生产反向代理终止 TLS 时保持应用本身 SSL=false，并要求可信代理传入 https scheme。
UTEN_REQUIRE_HTTPS=false
UTEN_SSL_ENABLED=false

# === 生产反向代理信任边界 ===
# Java 正则，仅允许实际反向代理的源 IP；生产建议收窄为负载均衡器/网关的精确地址。
# 应用 8080 端口还必须由防火墙或容器网络限制为仅该代理可访问。
UTEN_TRUSTED_PROXY_REGEX=10\..*|192\.168\..*|172\.(1[6-9]|2[0-9]|3[0-1])\..*|127\..*|::1

# === 引导超管 ===
# 仅首次启动由 ApplicationRunner 创建 admin 账号用；首登强制改密。
# 密码密封交付 IT 负责人，首登即改。
BOOTSTRAP_ADMIN_LOGIN=replace-with-the-approved-bootstrap-login
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-one-time-random-password-at-least-12-characters

# === 访客短信验证码 ===
# 网关：log（开发期模拟且不记录验证码）/ aliyun（阿里云）
UTEN_SMS_PROVIDER=log
# 阿里云（provider=aliyun 时必填）
UTEN_SMS_ACCESS_KEY_ID=
UTEN_SMS_ACCESS_KEY_SECRET=
UTEN_SMS_SIGN_NAME=
UTEN_SMS_TEMPLATE_CODE=
UTEN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# === 附件对象存储 ===
# 后端：local（仅开发/隔离测试）/ oss（本地生产与云端生产必须共用同一私有 Bucket）/ disabled。
# 物理数据库复制只同步附件元数据，不同步本地磁盘文件；生产两端不得一端 local、一端 oss。
UTEN_STORAGE_PROVIDER=local
UTEN_STORAGE_MAX_BYTES=26214400
UTEN_STORAGE_PRESIGN_EXPIRY=300
UTEN_STORAGE_LOCAL_DIR=./data/attachments
# 阿里云 OSS（provider=oss 时填）。云端 ECS 建议 UTEN_OSS_USE_INSTANCE_ROLE=true 免 AccessKey。
UTEN_OSS_ENDPOINT=
UTEN_OSS_INTERNAL_ENDPOINT=
UTEN_OSS_BUCKET=
UTEN_OSS_REGION=
UTEN_OSS_ACCESS_KEY_ID=
UTEN_OSS_ACCESS_KEY_SECRET=
UTEN_OSS_USE_INSTANCE_ROLE=false
UTEN_OSS_ROLE_NAME=
UTEN_OSS_KEY_PREFIX=attachments/
# 生产必须为 true；应用会在启动时确认 Bucket 版本控制为 Enabled。
# RAM 需按实际版本路径授予 GetObjectVersion/DeleteObjectVersion；
# ListObjectVersions 只给临时审计/恢复身份，禁止 AliyunOSSFullAccess。
UTEN_OSS_REQUIRE_VERSIONING=false

# === 云端部署（生产必须 UTEN_PROFILE=cloud,prod）双数据源（仅云端 ECS 用）===
# 主库=公司本地服务器（经 VPN/专线）；副本=云端本地只读 PG。生产必须校验证书，
# 且连接超时要有限；缺这些 key，cloud profile 启动即 fail-fast。
UTEN_DB_PRIMARY_URL=jdbc:postgresql://pg-primary.imp.internal:5432/uten_imp?sslmode=verify-full&sslrootcert=/etc/uten-imp/tls/company-root-ca.crt&connectTimeout=5&tcpKeepAlive=true
UTEN_DB_REPLICA_URL=jdbc:postgresql://pg-standby.imp.internal:5432/uten_imp?sslmode=verify-full&sslrootcert=/etc/uten-imp/tls/company-root-ca.crt&connectTimeout=5&tcpKeepAlive=true

# Flutter 移动/桌面 Release 还必须在构建时固定两个受控端点，不能由员工手填 host：
# --dart-define=API_BASE_URL=https://office.imp.example.com/api
# --dart-define=CLOUD_API_BASE_URL=https://imp.example.com/api

# === 官方政策情报（可选）===
# 默认关闭；启用后只抓取预设政府官网，DeepSeek 仅做结构化摘要。
# 密钥只通过环境变量或生产密钥管理注入，不要提交真实值。
UTEN_POLICY_INTELLIGENCE_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
UTEN_POLICY_INTELLIGENCE_CRON=0 15 6 * * *
UTEN_POLICY_INTELLIGENCE_MAX_CANDIDATES=12
