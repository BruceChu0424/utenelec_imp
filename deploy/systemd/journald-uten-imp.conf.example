# Install only after the real root filesystem capacity and retention window
# have been reviewed.  The host monitor pins the installed bytes and effective
# merged configuration; this template is not itself commissioning evidence.
[Journal]
Storage=persistent
Compress=yes
Seal=yes
SystemMaxUse=2G
SystemKeepFree=5G
SystemMaxFileSize=128M
MaxRetentionSec=30day
RateLimitIntervalSec=30s
RateLimitBurst=20000
