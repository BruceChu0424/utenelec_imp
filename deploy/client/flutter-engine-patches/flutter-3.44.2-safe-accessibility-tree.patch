+ui::AXTreeUpdate SnapshotTree(const ui::AXTree& tree) {
+  ui::AXTreeUpdate snapshot;
+  snapshot.has_tree_data = true;
+  snapshot.tree_data = tree.data();
+  if (!tree.root() || tree.root()->id() == ui::AXNode::kInvalidAXID) {
+    return snapshot;
+  }
+  snapshot.root_id = tree.root()->id();
+  std::vector<const ui::AXNode*> remaining{tree.root()};
+  while (!remaining.empty()) {
+    const ui::AXNode* node = remaining.back();
+    remaining.pop_back();
+    snapshot.nodes.push_back(node->data());
+    for (auto child = node->children().rbegin();
+         child != node->children().rend(); ++child) {
+      remaining.push_back(*child);
+    }
+  }
+  return snapshot;
+}
+
+bool OrderPendingNodes(ui::AXTreeUpdate& update) {
+  std::unordered_map<int32_t, const ui::AXNodeData*> nodes;
+  for (const auto& node : update.nodes) {
+    nodes[node.id] = &node;
+  }
+  std::unordered_map<int32_t, int> state;
+  std::vector<ui::AXNodeData> ordered;
+  std::function<bool(int32_t)> visit = [&](int32_t id) {
+    if (state[id] == 2)
+      return true;
+    if (state[id] == 1)
+      return false;
+    state[id] = 1;
+    for (int32_t child : nodes.at(id)->child_ids) {
+      if (nodes.find(child) != nodes.end() && !visit(child))
+        return false;
+    }
+    state[id] = 2;
+    ordered.push_back(*nodes.at(id));
+    return true;
+  };
+  for (const auto& node : update.nodes) {
+    if (!visit(node.id))
+      return false;
+  }
+  std::reverse(ordered.begin(), ordered.end());
+  update.nodes = std::move(ordered);
+  return true;
+}
