{
  "name": "uten-website",
  "version": "1.0.0",
  "private": true,
  "description": "中山市优腾电器有限公司官网 (Next.js 全栈 + 多语言 CMS)",
  "engines": {
    "node": ">=22.13.1 <23 || >=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/generate-clients.mjs && next build --webpack",
    "postinstall": "node scripts/generate-clients.mjs",
    "db:generate": "node scripts/generate-clients.mjs",
    "db:migrate:postgresql": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "deploy:assemble": "node deploy/assemble-release.mjs",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill": "tsx prisma/backfill-website-v2.ts",
    "db:upgrade": "prisma db push && tsx prisma/backfill-website-v2.ts",
    "db:studio": "prisma studio",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "legacy:import:dry-run": "tsx scripts/import-legacy-v2.ts dry-run",
    "legacy:import:apply": "tsx scripts/import-legacy-v2.ts apply",
    "catalog:normalize": "tsx prisma/normalize-product-catalog.ts",
    "catalog:normalize:apply": "tsx prisma/normalize-product-catalog.ts --apply",
    "catalog:repair-content": "tsx prisma/repair-legacy-series-content.ts",
    "catalog:repair-content:apply": "tsx prisma/repair-legacy-series-content.ts --apply",
    "content:guides": "tsx prisma/seed-international-guides.ts",
    "content:international-settings": "tsx prisma/backfill-international-settings.ts",
    "content:public-claims": "tsx prisma/harden-public-claims.ts",
    "test:admin-guardrails": "tsx --test tests/admin-guardrails.test.ts",
    "test:all": "tsx --test tests/*.test.ts",
    "test:upload-storage": "tsx --test tests/upload-storage.test.ts",
    "test:catalog-public": "tsx --test tests/catalog-public-contract.test.ts",
    "test:catalog-normalization": "tsx --test tests/catalog-normalization.test.ts",
    "test:legacy-series-content": "tsx --test tests/legacy-series-content-repair.test.ts",
    "test:inquiry-security": "tsx --test tests/inquiry-security.test.ts",
    "test:legacy-import": "tsx --test tests/legacy-v2-import.test.ts",
    "test:news-content": "tsx --test tests/news-content.test.ts",
    "test:seo-localization": "tsx --test tests/seo-localization.test.ts",
    "test:publication-guards": "tsx --test tests/publication-guards.test.ts",
    "test:prisma-migrations": "node scripts/verify-prisma-migrations.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@swc/helpers": "0.5.17",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "next": "16.4.2",
    "next-intl": "4.13.5",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.8.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "braces": "^3.0.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "eslint-plugin-import@2.32.0": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y@6.10.2": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react@7.37.5": {
      "eslint": "$eslint"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "postcss-nested": {
      "postcss-selector-parser": "7.1.7"
    },
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tailwindcss": {
      "postcss-selector-parser": "7.1.7"
    },
    "zod": "4.6.7"
  }
}
