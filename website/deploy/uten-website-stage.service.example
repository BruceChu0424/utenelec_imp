[Unit]
Description=Stage and verify signed Uten website release from OSS (no activation)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/uten-website/enable-auto-staging

[Service]
Type=oneshot
User=uten-website-updater
Group=uten-website-updater
ExecStart=/usr/local/libexec/uten-website/uten-website-stage
RuntimeDirectory=uten-website-stage
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/uten-website/updater/staged /run/uten-website-stage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
