# 兼容旧安装的退役单元；安装器仍须 disable --now，不能恢复自动检查 OSS。
# 安装为 /etc/systemd/system/uten-imp-updater.timer
[Unit]
Description=Retired Uten IMP automatic update schedule
# Linux 根目录始终存在，取反条件阻止误启用后启动。手动检查走运维服务。
ConditionPathExists=!/

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
