# Backend publication verification only. Merge these public settings into the backend
# service environment, not updater.env. No signing private key belongs on the server.
# Until all settings are present, new Windows uploads/publications fail closed;
# existing published downloads and recovery keep their historical behavior.

# SHA-256 of the company signer's DER leaf certificate; comma-separated (maximum 4)
# for audited rotation. This is not SHA-1 thumbprint or SHA-256 of the EXE.
UTEN_WINDOWS_PUBLISHER_SHA256=

# Controlled osslsigncode 2.14 or a newer security-fixed version, absolute path.
# Debian bookworm's original 2.5 package is too old for untrusted uploads.
UTEN_WINDOWS_SIGNATURE_VERIFIER=/usr/local/bin/osslsigncode

# Public CA roots approved for Microsoft Windows code signing and timestamping.
# Keep separate from the company's intranet HTTPS CA; never add a test/self-signed
# root to employees' Windows trust stores to make a formal release pass.
UTEN_WINDOWS_SIGNATURE_CA_FILE=/etc/uten-imp/windows-signature/code-signing-roots.pem
UTEN_WINDOWS_SIGNATURE_TSA_CA_FILE=/etc/uten-imp/windows-signature/timestamp-roots.pem

# Fresh, independently retrieved public issuer CRLs for both chains. The native
# verifier checks signatures and validity; missing/stale/revoked data rejects a new
# publication. CDP URLs in uploaded certificates are not fetched by the server.
UTEN_WINDOWS_SIGNATURE_CRL_FILE=/etc/uten-imp/windows-signature/code-signing-crls.pem
UTEN_WINDOWS_SIGNATURE_TSA_CRL_FILE=/etc/uten-imp/windows-signature/timestamp-crls.pem
