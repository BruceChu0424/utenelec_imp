# LEGACY-CLOUD-UNIT-DO-NOT-INSTALL
# 历史云端（阿里云 ECS）systemd 设计样例；禁止复制、安装或启用。
# 它缺少当前双 JAR、独立 migrator、签名激活器和持久失败/boot marker 合同。
# 仅供重写受审 cloud activator 时参考；以 README-cloud.md 顶部停用边界为准。
[Unit]
Description=Uten IMP cloud instance (remote-access gateway + read replica)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=uten-imp
Group=uten-imp
WorkingDirectory=/opt/uten-imp/current
EnvironmentFile=/etc/uten-imp/server-cloud.env
ExecStartPre=/usr/bin/test -L /opt/uten-imp/current
ExecStartPre=/usr/bin/test -r /opt/uten-imp/current/server/uten-imp-server.jar
ExecStart=/usr/bin/java -XX:+ExitOnOutOfMemoryError -jar /opt/uten-imp/current/server/uten-imp-server.jar
Restart=always
RestartSec=3
SuccessExitStatus=143
TimeoutStartSec=60
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
