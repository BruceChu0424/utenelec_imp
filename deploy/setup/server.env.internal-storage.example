# Complete first-install template for the current Simple deployment (private internal storage).
# Install only after replacing every REPLACE value with an approved/generated value.
# Treat this file as data, never source it. For an upgrade merge required fields;
# never replace existing DB/JWT/PGP/HMAC/AI keys or bootstrap state with this example.
UTEN_PROFILE=prod
UTEN_DEPLOYMENT_SITE=local
UTEN_BUSINESS_DATA_RESET_ENABLED=false
UTEN_LOCAL_ALLOWED_CIDRS=127.0.0.0/8,REPLACE_EXACT_OFFICE_CIDR
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
UTEN_DB_URL=jdbc:postgresql://127.0.0.1:5432/uten_imp
UTEN_DB_USER=uten
UTEN_DB_PASSWORD=REPLACE_GENERATED_DATABASE_PASSWORD
SPRING_FLYWAY_ENABLED=false

# Generate four independent random secrets; never copy real values into the repository.
UTEN_JWT_SECRET=REPLACE_INDEPENDENT_JWT_SECRET_AT_LEAST_32_BYTES
UTEN_JWT_ISSUER=uten-imp
UTEN_PGP_MASTER_KEY=REPLACE_INDEPENDENT_PGP_MASTER_KEY_AT_LEAST_32_BYTES
UTEN_PGP_KEY_VERSION=1
UTEN_HMAC_KEY=REPLACE_INDEPENDENT_HMAC_KEY_AT_LEAST_32_BYTES
UTEN_SECRET_CIPHER_KEY=REPLACE_INDEPENDENT_AI_CIPHER_KEY_AT_LEAST_32_BYTES

UTEN_REQUIRE_HTTPS=true
UTEN_SSL_ENABLED=false
UTEN_CORS_ORIGINS=https://REPLACE_WITH_EXACT_ALLOWED_ORIGIN
UTEN_TRUSTED_PROXY_REGEX=127[.].*|::1
UTEN_SWAGGER_ENABLED=false
UTEN_MANAGER_PERMISSION_DELEGATION_ENABLED=true
UTEN_LEGACY_ENABLED=false
UTEN_SMS_PROVIDER=disabled
UTEN_SMS_EXPOSE_CODE=false
UTEN_AI_OUTBOUND_ENABLED=false
UTEN_AI_ALLOW_OVERSEAS=false

# First installation only. Retire this independent one-time credential after
# verified forced password change; preserve the existing retired state on upgrades.
UTEN_BOOTSTRAP_ADMIN_RETIRED=false
BOOTSTRAP_ADMIN_LOGIN=REPLACE_APPROVED_BOOTSTRAP_ADMIN_LOGIN
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_GENERATED_ONE_TIME_48_HEX_PASSWORD

UTEN_STORAGE_PROVIDER=internal
UTEN_INTERNAL_STORAGE_ROOT=/var/lib/uten-imp-media/attachments
UTEN_INTERNAL_STORAGE_MAX_CONCURRENT_IO=2
UTEN_INTERNAL_STORAGE_MIN_FREE_BYTES=10737418240
UTEN_ATTACHMENT_UPLOADS_ENABLED=false
UTEN_ATTACHMENT_SCANNER_PROVIDER=clamav
UTEN_CLAMAV_UNIX_SOCKET=/run/clamav/clamd.ctl
UTEN_STORAGE_MAX_BYTES=26214400
UTEN_STORAGE_PRESIGN_EXPIRY=300
UTEN_ATTACHMENT_RECONCILIATION_ENABLED=false
UTEN_STORAGE_LEGACY_LOCAL_READ_ENABLED=false
UTEN_STORAGE_LEGACY_OSS_READ_ENABLED=false
# Enable a historical reader only after its reference report and exact originals
# are verified; supply its separate original directory or versioned OSS settings.
# Verify private media, ClamAV clean/EICAR and exact paired restore before intake.
