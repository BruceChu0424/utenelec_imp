  "rules": {
    "databaseVersion": "Canonical manifest/TSV identity is ASCII decimal components with positive first component, no leading-zero/trailing-zero aliases; this canonical API is NOT applied blindly to raw installed history.",
    "filenameVersion": "V<components>__<nonempty-description>.sql; historical positive pure-integer filename padding (V01..V09) normalizes to canonical integer DB text without renaming. Compound filename components stay canonical. Dot and underscore separators normalize to dotted version. Preserve filenames in digests and retain caller-specific description validation.",
    "comparison": "Lexicographic arbitrary-precision integer-component tuple; never float or concatenated integers.",
    "inventory": "Duplicate canonical versions, including distinct filenames normalizing to one version, must be rejected.",
    "receiptHead": "Health/receipt head remains an integer only when the maximum canonical version is a single component. A compound maximum is rejected, never truncated.",
    "historyVersion": "Installed history raw text must equal the validated original filename token with underscores replaced by dots, including immutable V01..V09 padding. Return canonical tuple only for comparison/dedup/head; never rewrite the raw row or its audit/digest bytes. Expected raw projection is derived from the already-signed original filename.",
    "historyDescription": "Keep manifest description exactly the original filename description. Expected installed history description is derived only from that signed filename by replacing underscores with spaces; never rewrite observed raw description/digest or ignore its mismatch."
  },
