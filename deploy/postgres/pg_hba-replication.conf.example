# Apply to the exact hba_file reported by SHOW hba_file on both the on-premises
# primary and cloud promotion candidate. A Debian hba_file under /etc is not
# copied by pg_basebackup, so never assume the standby inherited these rules.
# Prefer exact host /32 (or /128) entries rather than an entire VPN subnet.
# PostgreSQL TLS must be enabled; clients must use sslmode=verify-full.
# Replace every placeholder before reload.

# Physical replication connection only.
hostssl  replication  __REPL_USER__  __CLOUD_REPLICA_CIDR__  scram-sha-256

# Normal cloud Spring application connection to the one writable primary.
# The application role is separate from the replication and admin roles.
hostssl  __APP_DATABASE__  __APP_USER__  __CLOUD_APP_CIDR__  scram-sha-256

# Dormant disaster-recovery rules. Physical backup copies these rules to the
# cloud standby, so after a fenced promotion the on-premises application can
# reach the new cloud primary and the old primary can be rebuilt as a standby.
hostssl  replication  __REPL_USER__  __ON_PREM_REPLICA_CIDR__  scram-sha-256
hostssl  __APP_DATABASE__  __APP_USER__  __ON_PREM_APP_CIDR__  scram-sha-256

# Do not expose a remote postgres/admin rule. Run prepare-primary.sh locally on
# the primary host and keep PostgreSQL 5432 reachable only through the private
# VPN/Express Connect route and host firewall/security rules.
