# Cloud host ingress only. The independent uten_remote table remains intact.
table inet uten_cloud_host {
    comment "Uten cloud host firewall schema 1"
    chain input {
        type filter hook input priority 10; policy drop;
        iifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        ip protocol icmp icmp type echo-request limit rate 5/second burst 10 packets accept
        meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
        iifname "@@PUBLIC_INTERFACE@@" ip6 hoplimit 255 icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
@@DHCPV4_RULE@@@@SSH_RULE@@
        iifname "@@PUBLIC_INTERFACE@@" meta nfproto ipv4 tcp dport 443 ct state new accept
        iifname "@@PUBLIC_INTERFACE@@" ip saddr { @@WIREGUARD_IPV4_SOURCES@@ } udp dport 51820 accept
    }
    chain forward {
        type filter hook forward priority 10; policy drop;
    }
}
